#!/bin/sh
set -e

# Find latest installed /opt/podman-<version> (with or without a leading 'v')
PREFIX=""
if ls -1d /opt/podman-* >/dev/null 2>&1; then
  # filter out the plain /opt/podman symlink/dir if present, and pick the highest version
  PREFIX="$(ls -1d /opt/podman-* 2>/dev/null | grep -E '/opt/podman-(v)?[0-9]' | sort -V | tail -n1)"
fi

# Create /opt/podman symlink pointing to the latest version
if [ -n "$PREFIX" ]; then
  ln -sfn "$PREFIX" /opt/podman
fi

# Ensure containers config exists
mkdir -p /etc/containers
if [ ! -f /etc/containers/containers.conf ]; then
  cat > /etc/containers/containers.conf <<'EOF'
[engine]
runtime = "/opt/podman/bin/crun"
helper_binaries_dir = ["/opt/podman/libexec/podman", "/opt/podman/bin"]
network_backend = "netavark"
cgroup_manager = "systemd"
EOF
fi

if [ ! -f /etc/containers/registries.conf ]; then
  cat > /etc/containers/registries.conf <<'EOF'
unqualified-search-registries = ["docker.io"]
[registries.search]
registries=["docker.io","quay.io","registry.fedoraproject.org"]
[registries.block]
registries=[]
EOF
fi

# Ensure 'ops' user and rootless setup
if ! getent group ops >/dev/null 2>&1; then
  addgroup --system ops || addgroup ops || true
fi
if ! id -u ops >/dev/null 2>&1; then
  adduser --disabled-password --gecos "" --ingroup ops ops || true
fi
grep -q '^ops:' /etc/subuid || echo 'ops:100000:65536' >> /etc/subuid
grep -q '^ops:' /etc/subgid || echo 'ops:100000:65536' >> /etc/subgid
command -v loginctl >/dev/null 2>&1 && loginctl enable-linger ops || true
install -d -m 0755 /etc/containers/systemd
install -d -m 0755 /home/ops/.config/containers/systemd || true
chown -R ops:ops /home/ops/.config/containers || true

# Systemd units (system scope)
if [ -n "$PREFIX" ] && [ -d "$PREFIX/lib/systemd/system" ]; then
  ln -sfn "$PREFIX/lib/systemd/system/podman.socket"  /etc/systemd/system/podman.socket  || true
  ln -sfn "$PREFIX/lib/systemd/system/podman.service" /etc/systemd/system/podman.service || true
  command -v systemctl >/dev/null 2>&1 && systemctl daemon-reload || true
fi

# Capabilities for passt/pasta if present
for bin in /opt/podman/bin/passt /opt/podman/bin/pasta; do
  if [ -x "$bin" ] && command -v setcap >/dev/null 2>&1; then
    setcap cap_net_admin,cap_net_raw,cap_net_bind_service+ep "$bin" || true
  fi
done

# Convenience symlinks (idempotent, no cp)
safe_link () {
  src="$1"
  dst="$2"
  # If destination already resolves to the same file, do nothing
  if [ -e "$dst" ] || [ -L "$dst" ]; then
    # -ef compares if both paths refer to the same file
    if [ "$src" -ef "$dst" ] 2>/dev/null; then
      return 0
    fi
    # Replace existing file/symlink with a fresh symlink
    rm -f "$dst"
  fi
  ln -s "$src" "$dst" || true
}

for b in podman podman-remote quadlet crun conmon netavark aardvark-dns passt pasta; do
  if [ -x "/opt/podman/bin/$b" ]; then
    safe_link "/opt/podman/bin/$b" "/usr/local/bin/$b"
  fi
done

# Activate dynamic linker (harmless if nothing to do)
ldconfig || true

exit 0

